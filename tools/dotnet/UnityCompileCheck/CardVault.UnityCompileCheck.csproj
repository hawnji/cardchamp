<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-only check of the Unity presentation layer against UnityEngine reference
    assemblies from NuGet. It catches API and type errors outside the Editor; it does
    not replace opening the project in Unity.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Compiles the legacy Input Manager branch; remove this define to check the UI Toolkit cancel-event branch. -->
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/CardVault/Scripts/Unity/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/CardVault.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
  </ItemGroup>
</Project>
